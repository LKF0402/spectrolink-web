# Cloudflare Pages / Netlify 风格的长缓存头（GitHub Pages 会忽略本文件，无害）
# 目的：运行时文件体积大且带版本号，应该被浏览器与边缘节点长期缓存，避免每次打开重下 9 MB。

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/py/*
  Cache-Control: public, max-age=86400

/data/tables/*
  Cache-Control: public, max-age=86400

/data/manifest.json
  Cache-Control: public, max-age=300

/index.html
  Cache-Control: public, max-age=300
